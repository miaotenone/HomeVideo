{
  "device_id": "v831a",
  "hub_url": "http://raspberrypi.local:8000",
  "spool_dir": "/data/homevideo/spool",
  "log_level": "info",

  "capture": {
    "width": 1280,
    "height": 720,
    "fps": 15,
    "realtime": true
  },

  "encode": {
    "codec": "h264",
    "bitrate_bps": 1500000,
    "gop_ms": 2000
  },

  "detect": {
    "interval_ms": 200,
    "confirm_frames": 3,
    "confirm_hold_ms": 1000,
    "schedule_max_gap_ms": 1000,
    "detectors": [
      {
        "label": "person_intrusion",
        "model_path": "/data/homevideo/models/person-yolo-v1.model",
        "input_width": 224,
        "input_height": 224,
        "conf_threshold": 0.5,
        "model_version": "person-yolo-v1"
      },
      {
        "label": "fire_suspected",
        "model_path": "/data/homevideo/models/fire-yolo-v1.model",
        "input_width": 224,
        "input_height": 224,
        "conf_threshold": 0.5,
        "model_version": "fire-yolo-v1"
      },
      {
        "label": "smoke_suspected",
        "model_path": "/data/homevideo/models/smoke-yolo-v1.model",
        "input_width": 224,
        "input_height": 224,
        "conf_threshold": 0.5,
        "model_version": "smoke-yolo-v1"
      }
    ]
  },

  "event": {
    "pre_roll_ms": 10000,
    "post_roll_ms": 20000,
    "segment_ms": 60000,
    "segment_bytes": 4194304,
    "merge_window_ms": 30000,
    "ring_buffer_bytes": 8388608
  },

  "upload": {
    "heartbeat_ms": 10000,
    "arm_poll_ms": 5000,
    "max_backoff_ms": 60000,
    "max_attempts": 8,
    "rate_bytes_per_s": 262144,
    "http_timeout_ms": 10000
  },

  "quota": {
    "rolling_bytes": 33554432,
    "pending_bytes": 268435456,
    "uploaded_bytes": 536870912,
    "metadata_bytes": 16777216
  },

  "health": {
    "video_stale_ms": 5000,
    "recording_stale_ms": 5000,
    "max_stage_restarts": 5
  }
}
